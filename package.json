{
  "name": "ui-fixer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference-grounded website design retrieval MCP server and agent skill.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/index.cjs",
    "dev": "node --import tsx src/index.ts",
    "dev:http": "MCP_TRANSPORT=http node --import tsx src/index.ts",
    "start": "node dist/index.cjs",
    "start:http": "MCP_TRANSPORT=http node dist/index.cjs",
    "ingest": "node --import tsx scripts/ingest.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
