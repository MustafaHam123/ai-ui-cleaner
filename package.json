{
  "name": "ai-ui-cleaner",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Reference-grounded interface creation, review, and repair MCP server and agent skill.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/index.cjs",
    "dev": "node --import tsx src/index.ts",
    "dev:http": "MCP_TRANSPORT=http node --import tsx src/index.ts",
    "start": "node dist/index.cjs",
    "start:http": "MCP_TRANSPORT=http node dist/index.cjs",
    "ingest": "node --import tsx scripts/ingest.ts",
    "corpus:collect": "node --import tsx scripts/collect.ts",
    "corpus:import": "node --import tsx scripts/import-export.ts",
    "corpus:review": "node --import tsx scripts/review-code.ts",
    "corpus:images": "node --import tsx scripts/import-browser-images.ts",
    "corpus:caption": "node --import tsx scripts/caption-images.ts",
    "corpus:stage-images": "node --import tsx scripts/stage-images.ts",
    "test:cloud": "node --import tsx --test tests/cloud/*.test.ts",
    "cloud:provision": "node --import tsx scripts/provision-cloudflare.ts",
    "cloud:setup": "node --import tsx scripts/provision-cloudflare.ts --deploy --public --sync",
    "cloud:sync": "node --import tsx scripts/sync-cloud.ts",
    "cloud:smoke": "node --import tsx scripts/smoke-cloud.ts",
    "mcp:check": "node --import tsx scripts/check-hosted-mcp.ts",
    "cloud:dev": "wrangler dev --config wrangler.local.jsonc --port 8787 --show-interactive-dev-session=false",
    "cloud:migrate:local": "wrangler d1 migrations apply ai-ui-cleaner --local --config wrangler.local.jsonc",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261001.0-alpha",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
