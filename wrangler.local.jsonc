{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-ui-cleaner-local",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "ai-ui-cleaner", "database_id": "local-ai-ui-cleaner", "migrations_dir": "cloudflare/migrations" }],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "ai-ui-cleaner-corpus" }],
  "vars": { "ADMIN_TOKEN": "local-development-admin", "MCP_READ_TOKEN": "local-development-reader" }
}
