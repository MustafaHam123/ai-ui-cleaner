MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
PORT=3000

# Platform-delimited paths for local JSONL corpora.
# AI_UI_CLEANER_DATA_PATHS=./data/references.jsonl:./data/local/references.jsonl

# Controlled object-storage hosts allowed by get_reference_asset.
# AI_UI_CLEANER_ASSET_HOSTS=assets.example.com,private-assets.example.com
AI_UI_CLEANER_MAX_ASSET_BYTES=8388608

# Local preview files live under this directory (assets/ keys remain relative).
# AI_UI_CLEANER_ASSET_DIR=./data/local

# Owner provisioning only. Browser login is preferred; this token is optional for CI.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Set the URL to switch the stdio server to the remote corpus.
# Public endpoints need no MCP_READ_TOKEN; it is for private deployments only.
# AI_UI_CLEANER_CLOUD_URL=https://your-worker-origin
# MCP_READ_TOKEN=

# Ingestion only; keep separate from the read token.
# ADMIN_TOKEN=
